# Base de données (docker compose, port 5434)
DATABASE_URL="postgresql://ifspa:ifspa_dev@localhost:5434/ifspa?schema=public"
# Base des tests d'intégration (créée et vidée par les tests, jamais la base de dev)
DATABASE_URL_TEST="postgresql://ifspa:ifspa_dev@localhost:5434/ifspa_test?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generer-avec-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3100"
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Compte administrateur créé par le seed
SEED_ADMIN_EMAIL="admin@ifspa.mg"
SEED_ADMIN_PASSWORD="ChangezMoi2026!"
SEED_ADMIN_NAME="Administrateur IFSPA"

# Compte secrétariat (rôle user) pour le développement et les tests de bout en bout. Ne pas définir en production.
SEED_USER_EMAIL="secretariat@ifspa.mg"
SEED_USER_PASSWORD="Secretariat2026!"
SEED_USER_NAME="Secrétariat IFSPA"

# Formulaire de contact (Resend, domaine de l’expéditeur vérifié chez Resend). Sans clé en dev : envoi simulé dans la console.
RESEND_API_KEY=""
EMAIL_EXPEDITEUR="IFSPA <site@ifspa.mg>"
CONTACT_DESTINATAIRE="admin@ifspa.mg"
# Anti-robot Cloudflare Turnstile (gratuit) : https://dash.cloudflare.com > Turnstile. Sans clés en dev : ni widget ni vérification. Obligatoires en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
